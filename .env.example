# Decimal Dock environment variables
#
# Copy this file to `.env` and fill in your own key. `.env` is gitignored and
# must never be committed. These values are read on the server only (the Vercel
# function and the local dev middleware); they are never bundled into the
# browser and never sent to the client.
#
# The game runs completely without them: with no key set, every AI call
# reports "not configured" and the deterministic fallbacks take over.

# Your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id, taken from https://openrouter.ai/api/v1/models
# Default if unset: anthropic/claude-sonnet-5
# (verified present in the public /models listing on 2026-09-08)
OPENROUTER_MODEL=anthropic/claude-sonnet-5
